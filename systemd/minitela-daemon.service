[Unit]
Description=Minitela mini-display background daemon
Documentation=file:%h/Work/minitela-re/docs/findings.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/Work/minitela-re/minitela_daemon.py
Restart=on-failure
RestartSec=3
# Comma-separated substrings matched against the notification's app name,
# icon and summary. Default mirrors both the WhatsApp PWA and Whatsie.
# Environment=MINITELA_NOTIFY_MATCH=whatsapp,whatsie

[Install]
WantedBy=default.target
